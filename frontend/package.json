{
  "name": "woosarr-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript openapi.json -o src/generated/api.ts",
    "prebuild": "npm run gen",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run gen",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
